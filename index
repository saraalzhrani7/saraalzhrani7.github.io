<style>
  :root{
    --bg:#0E1116;
    --surface:#151A21;
    --surface-2:#1B212B;
    --surface-3:#212834;
    --border:#262E3A;
    --border-soft:#1E252F;
    --text:#EDF1F5;
    --text-dim:#93A0AD;
    --text-faint:#5C6673;
    --accent:#3FC7E8;
    --accent-dim:#2C93A8;
    --accent-soft:rgba(63,199,232,0.10);
    --sev-crit:#F0654B;
    --sev-high:#EBA23F;
    --sev-ok:#45C98A;
    --radius:3px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  [id]{ scroll-margin-top:84px; }
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Tajawal', sans-serif;
    line-height:1.75;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.disp{ font-family:'IBM Plex Sans Arabic', sans-serif; }
  .mono{ font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed; }
  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }
  ul{ list-style:none; }

  .wrap{ max-width:1140px; margin:0 auto; padding:0 32px; }
  section{ padding:100px 0; }
  @media (max-width:720px){ section{ padding:64px 0; } .wrap{ padding:0 20px; } }

  .tag{
    display:inline-flex; align-items:center; gap:9px;
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:12px; font-weight:500; letter-spacing:1px;
    color:var(--accent); text-transform:uppercase;
    margin-bottom:16px;
  }

  /* ===== NAV ===== */
  header{
    position:sticky; top:0; z-index:20;
    background:rgba(14,17,22,0.88); backdrop-filter:blur(8px);
    border-bottom:1px solid var(--border-soft);
  }
  nav.wrap{
    display:flex; align-items:center; justify-content:space-between;
    height:64px; gap:24px;
  }
  .brand{ font-weight:700; font-size:15.5px; letter-spacing:.3px; font-family:'IBM Plex Sans Arabic'; }
  .brand span{ color:var(--accent); }
  .status{
    display:flex; align-items:center; gap:8px;
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:11px; letter-spacing:.5px; color:var(--text-dim); text-transform:uppercase;
  }
  .status .dot{
    width:7px; height:7px; border-radius:50%; background:var(--sev-ok);
    box-shadow:0 0 0 3px rgba(69,201,138,0.18);
  }
  @media (max-width:720px){ .status{ display:none; } }
  .navlinks{ display:flex; gap:26px; font-size:13.5px; color:var(--text-dim); }
  .navlinks a:hover{ color:var(--text); }
  @media (max-width:640px){ .navlinks{ display:none; } }

  /* ===== BUTTONS ===== */
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    font-size:14px; font-weight:500; padding:12px 22px;
    border-radius:2px; border:1px solid var(--border);
    transition:.15s ease;
  }
  .btn::before{ content:"["; font-family:'IBM Plex Mono', monospace; color:var(--text-faint); margin-inline-end:1px; transition:.15s ease; }
  .btn::after{ content:"]"; font-family:'IBM Plex Mono', monospace; color:var(--text-faint); margin-inline-start:1px; transition:.15s ease; }
  .btn:hover::before, .btn:hover::after{ color:var(--accent); }
  .btn-primary{
    background:var(--accent); border-color:var(--accent); color:#06171B; font-weight:600;
    clip-path:polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
  }
  .btn-primary::before, .btn-primary::after{ color:#06171B; opacity:.5; }
  .btn-primary:hover{ background:#5ED4F0; box-shadow:0 0 0 1px var(--accent), 0 0 20px rgba(63,199,232,.4); }
  .btn-ghost{ color:var(--text); }
  .btn-ghost:hover{ border-color:var(--accent); color:var(--accent); }

  /* ===== HERO ===== */
  .hero{ padding:76px 0 90px; position:relative; overflow:hidden; }
  .hero::before{
    content:""; position:absolute; inset:0;
    background-image:
      linear-gradient(var(--border-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-soft) 1px, transparent 1px);
    background-size:44px 44px;
    -webkit-mask-image:radial-gradient(ellipse 90% 60% at 70% 0%, rgba(0,0,0,.6), transparent 70%);
    mask-image:radial-gradient(ellipse 90% 60% at 70% 0%, rgba(0,0,0,.6), transparent 70%);
    pointer-events:none;
  }
  .hero-grid{
    display:grid; grid-template-columns:1.25fr 1fr; gap:56px; align-items:start;
    position:relative;
  }
  @media (max-width:900px){ .hero-grid{ grid-template-columns:1fr; } }
  .eyebrow{
    display:inline-flex; align-items:center; gap:9px;
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:12.5px; font-weight:500; letter-spacing:1.5px;
    color:var(--accent); text-transform:uppercase; margin-bottom:22px;
  }
  .eyebrow::before{ content:""; width:22px; height:1px; background:var(--accent); }
  .hero-main h1{
    font-size:clamp(32px, 4.4vw, 50px); font-weight:800; line-height:1.28;
    color:var(--text); text-wrap:balance;
  }
  .hero-main h1 em{ font-style:normal; color:var(--accent); }
  .hero-main p{
    margin-top:22px; font-size:16.5px; color:var(--text-dim); max-width:520px; line-height:1.85;
  }
  .cta-row{ display:flex; flex-wrap:wrap; gap:12px; margin-top:32px; }

  .hero-panel{
    background:var(--surface); border:1px solid var(--border); border-radius:6px;
    overflow:hidden; margin-top:6px;
  }
  .panel-head{
    display:flex; align-items:center; gap:8px;
    padding:14px 18px; border-bottom:1px solid var(--border);
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:11px; letter-spacing:.5px; color:var(--text-dim); text-transform:uppercase;
  }
  .panel-head .dot{ width:6px; height:6px; border-radius:50%; background:var(--accent); }
  .panel-head .mono{ margin-inline-start:auto; color:var(--text-faint); font-size:10.5px; }
  .panel-grid{ display:grid; grid-template-columns:1fr 1fr; }
  .stat{ padding:22px 18px; border-inline-end:1px solid var(--border); border-bottom:1px solid var(--border); }
  .stat:nth-child(2n){ border-inline-end:none; }
  .stat:nth-last-child(-n+2){ border-bottom:none; }
  .stat-num{
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:27px; font-weight:600; color:var(--text); font-variant-numeric:tabular-nums;
  }
  .stat-num small{ font-size:14px; color:var(--accent); }
  .stat-lbl{ margin-top:6px; font-size:12px; color:var(--text-dim); line-height:1.5; }

  /* ===== SCENARIO ===== */
  #scenario{ border-top:1px solid var(--border-soft); }
  #scenario .lead{ margin-top:14px; font-size:15.5px; color:var(--text-dim); max-width:600px; }
  .scn-panel{
    margin-top:40px; background:var(--surface); border:1px solid var(--border); border-radius:6px;
    overflow:hidden;
  }
  .scn-log{ padding:18px 22px; border-bottom:1px solid var(--border); background:var(--bg); }
  .scn-line{
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:12.5px; color:var(--text-dim); line-height:2; white-space:normal;
  }
  .scn-line .mono{ color:var(--text-faint); }
  .sev{
    display:inline-block; font-family:'IBM Plex Mono', monospace; font-size:10.5px; font-weight:600;
    letter-spacing:.5px; padding:1px 8px; border-radius:3px; margin:0 4px;
  }
  .sev.high{ background:rgba(235,162,63,0.15); color:var(--sev-high); }
  .scn-choices{ padding:28px 26px; counter-reset:opt; }
  .scn-q{
    font-family:'IBM Plex Sans Arabic'; font-weight:700; font-size:16px; color:var(--text); margin-bottom:16px;
  }
  .scn-btn{
    display:flex; align-items:center; gap:12px;
    width:100%; text-align:start; font-family:'Tajawal', sans-serif;
    font-size:14.5px; color:var(--text); background:var(--bg); border:1px solid var(--border);
    border-inline-start:2px solid var(--border);
    border-radius:2px; padding:15px 18px; margin-bottom:10px; cursor:pointer; transition:.15s ease;
  }
  .scn-btn::before{
    content:"[" counter(opt, decimal-leading-zero) "]"; counter-increment:opt;
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:12px; color:var(--text-faint); flex-shrink:0; transition:.15s ease;
  }
  .scn-btn:last-child{ margin-bottom:0; }
  .scn-btn:hover{ border-color:var(--accent); border-inline-start-color:var(--accent); color:var(--accent); background:var(--accent-soft); }
  .scn-btn:hover::before{ color:var(--accent); }
  .scn-outcome{ padding:30px 26px; }
  .scn-badge{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:13px; font-weight:600; letter-spacing:.4px;
    padding:6px 14px; border-radius:20px; margin-bottom:16px;
  }
  .scn-badge.bad{ background:rgba(240,101,75,0.12); color:var(--sev-crit); }
  .scn-badge.good{ background:rgba(69,201,138,0.12); color:var(--sev-ok); }
  .scn-outcome p{ font-size:15px; color:var(--text-dim); line-height:1.85; max-width:600px; }
  .scn-actions{ display:flex; flex-wrap:wrap; align-items:center; gap:18px; margin-top:22px; }
  .scn-link{ font-size:14px; color:var(--accent); font-weight:500; }
  .scn-link:hover{ text-decoration:underline; }
  .scn-again{
    font-family:'Tajawal', sans-serif; font-size:13.5px; color:var(--text-faint);
    background:none; border:none; cursor:pointer; padding:0;
  }
  .scn-again:hover{ color:var(--text-dim); }
  @media (max-width:600px){ .scn-line{ font-size:11.5px; } }

  /* ===== ABOUT ===== */
  #about{ border-top:1px solid var(--border-soft); }
  .about-grid{ display:grid; grid-template-columns:1fr 1.15fr; gap:64px; align-items:start; }
  @media (max-width:860px){ .about-grid{ grid-template-columns:1fr; } }
  h2{ font-size:clamp(26px, 3.2vw, 36px); font-weight:800; color:var(--text); }
  #about p{ margin-top:18px; font-size:15.5px; color:var(--text-dim); max-width:480px; }
  .skillcol{ margin-bottom:26px; }
  .skillcol:last-child{ margin-bottom:0; }
  .skillcol h3{
    display:flex; align-items:center; gap:10px;
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:12px; font-weight:500; letter-spacing:1px; color:var(--text-dim);
    text-transform:uppercase; margin-bottom:12px;
  }
  .skillcol h3 .idx{
    width:20px; height:20px; border:1px solid var(--accent); border-radius:50%;
    color:var(--accent); font-size:10.5px; display:flex; align-items:center; justify-content:center;
  }
  .chips{ display:flex; flex-wrap:wrap; gap:9px; }
  .chip{
    font-size:13px; color:var(--text-dim); border:1px solid var(--border);
    border-radius:20px; padding:7px 15px; background:var(--surface);
  }

  /* ===== WHAT I DO ===== */
  #whatido{ border-top:1px solid var(--border-soft); }
  .whatido-grid{ display:grid; grid-template-columns:0.85fr 1.25fr; gap:64px; align-items:start; }
  @media (max-width:860px){ .whatido-grid{ grid-template-columns:1fr; } }
  .whatido-lead{ margin-top:18px; font-size:15.5px; color:var(--text-dim); max-width:440px; }
  #whatido .btn{ margin-top:28px; }
  .cap-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; }
  @media (max-width:860px){ .cap-grid{ grid-template-columns:repeat(2, 1fr); } }
  @media (max-width:520px){ .cap-grid{ grid-template-columns:1fr; } }
  .cap-card{
    background:var(--surface); border:1px solid var(--border); border-radius:8px;
    padding:22px; transition:.2s ease;
  }
  .cap-card:hover{ border-color:var(--accent); background:var(--surface-2); }
  .cap-icon{
    width:40px; height:40px; display:flex; align-items:center; justify-content:center;
    background:var(--accent-soft); border-radius:8px; color:var(--accent); margin-bottom:14px;
  }
  .cap-icon svg{ width:20px; height:20px; }
  .cap-card h3{ font-size:15px; font-weight:700; color:var(--text); margin-bottom:6px; }
  .cap-card p{ font-size:13px; color:var(--text-dim); line-height:1.6; }

  /* ===== SKILLS / TOOLKIT ===== */
  #skills .skills-sub{ margin-top:14px; font-size:15.5px; color:var(--text-dim); max-width:520px; }
  .tool-grid{ display:flex; flex-wrap:wrap; gap:22px; margin-top:44px; }
  .tool{ display:flex; flex-direction:column; align-items:center; gap:11px; width:96px; }
  .tool-icon{
    width:72px; height:72px; display:flex; align-items:center; justify-content:center;
    background:var(--surface); border:1px solid var(--border); border-radius:14px;
    color:var(--accent); transition:.2s ease;
  }
  .tool-icon svg{ width:30px; height:30px; }
  .tool:hover .tool-icon{
    border-color:var(--accent); background:var(--surface-2);
    transform:translateY(-3px); box-shadow:0 10px 24px rgba(63,199,232,0.12);
  }
  .tool-name{ font-size:12.5px; color:var(--text-dim); direction:ltr; unicode-bidi:embed; }
  @media (max-width:720px){
    .tool{ width:78px; }
    .tool-icon{ width:60px; height:60px; border-radius:12px; }
    .tool-icon svg{ width:26px; height:26px; }
  }

  /* ===== PROJECTS ===== */
  #projects{ border-top:1px solid var(--border-soft); background:var(--surface); }
  #projects > .wrap > p.lead{ margin-top:14px; font-size:15.5px; color:var(--text-dim); max-width:560px; }
  .case-list{ display:flex; flex-direction:column; gap:24px; margin-top:52px; }
  .case{
    display:grid; grid-template-columns:0.92fr 1.3fr; gap:0;
    background:var(--bg); border:1px solid var(--border); border-radius:6px; overflow:hidden;
  }
  @media (max-width:820px){ .case{ grid-template-columns:1fr; } }
  .case-media{ position:relative; background:var(--surface-2); }
  .case-chrome{
    display:flex; gap:6px; padding:10px 14px; background:var(--surface-3); border-bottom:1px solid var(--border);
  }
  .case-chrome span{ width:8px; height:8px; border-radius:50%; background:var(--border); }
  .case-media img{ width:100%; height:220px; object-fit:cover; object-position:top; display:block; }
  @media (max-width:820px){ .case-media img{ height:200px; } }
  .case-body{ padding:30px 32px; display:flex; flex-direction:column; }
  .case-tophead{ display:flex; align-items:center; gap:12px; margin-bottom:12px; }
  .case-id{
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:12px; font-weight:600; color:var(--accent); letter-spacing:.5px;
  }
  .case-type{
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:11px; color:var(--text-dim); border:1px solid var(--border);
    border-radius:20px; padding:3px 11px; text-transform:uppercase; letter-spacing:.5px;
  }
  .case-body h3{ font-size:20px; font-weight:700; color:var(--text); margin-bottom:10px; }
  .case-body > p{ font-size:14.5px; color:var(--text-dim); line-height:1.8; }
  .case-meta{
    display:grid; grid-template-columns:1fr 1fr; gap:14px;
    margin:18px 0; padding:14px 16px; background:var(--surface); border:1px solid var(--border-soft); border-radius:4px;
  }
  @media (max-width:520px){ .case-meta{ grid-template-columns:1fr; } }
  .case-meta .k{
    display:block; font-family:'IBM Plex Mono', monospace;
    font-size:10.5px; letter-spacing:1px; color:var(--accent); margin-bottom:4px;
  }
  .case-meta div{ font-size:13.5px; color:var(--text-dim); line-height:1.6; }
  .findings{ display:flex; flex-direction:column; gap:8px; margin-bottom:8px; }
  .findings li{ font-size:14px; color:var(--text-dim); display:flex; gap:9px; line-height:1.7; }
  .findings li::before{ content:"→"; color:var(--accent); flex-shrink:0; font-family:'IBM Plex Mono'; }
  .case-links{ margin-top:auto; padding-top:16px; display:flex; flex-direction:column; gap:6px; }
  .case-links a{
    font-family:'IBM Plex Mono', monospace; direction:ltr; unicode-bidi:embed;
    font-size:12.5px; color:var(--accent); width:fit-content;
  }
  .case-links a:hover{ text-decoration:underline; }
  .case-note{
    margin-top:auto; padding-top:16px; font-size:12.5px; color:var(--text-faint); font-style:italic;
  }

  /* ---- hacker/terminal atmosphere for cyber-security case studies (as in the original site) ---- */
  .case-sec{
    position:relative;
    background:
      repeating-linear-gradient(180deg, rgba(47,227,138,0.035) 0px, rgba(47,227,138,0.035) 1px, transparent 1px, transparent 3px),
      radial-gradient(circle at 85% 0%, rgba(47,227,138,0.08), transparent 55%),
      #060B08;
    border-color:#1f5c3c;
    box-shadow:0 0 0 1px rgba(47,227,138,0.15), 0 0 30px rgba(47,227,138,0.08) inset;
  }
  .case-sec:hover{
    border-color:#2fe38a;
    box-shadow:0 0 0 1px rgba(47,227,138,0.4), 0 0 34px rgba(47,227,138,0.22);
  }
  .case-sec .case-chrome{ background:transparent; border-bottom-color:#1f5c3c; }
  .case-sec .case-chrome span{ background:#1f5c3c; }
  .case-sec .case-media img{ filter:grayscale(.3) contrast(1.1) brightness(.95); }
  .case-sec .case-body{ font-family:'IBM Plex Mono', monospace; }
  .case-sec .case-body::before{
    content:"● ● ●"; display:block; letter-spacing:6px; font-size:9px; color:#1f5c3c; margin-bottom:2px;
  }
  .case-sec .case-id{
    color:#2fe38a; text-shadow:0 0 8px rgba(47,227,138,0.6);
    display:inline-flex; align-items:center; gap:6px;
  }
  .case-sec .case-id::before{ content:"root@sara:~#"; opacity:.75; font-size:11px; }
  .case-sec .case-id::after{
    content:""; width:7px; height:13px; background:#2fe38a; display:inline-block;
    box-shadow:0 0 6px rgba(47,227,138,0.9); animation:blink 1s step-end infinite;
  }
  @media (prefers-reduced-motion:reduce){ .case-sec .case-id::after{ animation:none; } }
  .case-sec .case-type{ border-color:#1f5c3c; color:#2fe38a; }
  .case-sec h3{ color:#d4ffe8; font-family:'IBM Plex Sans Arabic', sans-serif; }
  .case-sec .case-body > p{ color:#7fb89a; }
  .case-sec .case-meta{
    background:rgba(47,227,138,0.04); border-color:#1f5c3c; border-inline-start:2px solid #2fe38a;
  }
  .case-sec .case-meta .k{ color:#2fe38a; }
  .case-sec .case-meta div{ color:#7fb89a; }
  .case-sec .findings li{ color:#7fb89a; }
  .case-sec .findings li::before{ color:#2fe38a; }
