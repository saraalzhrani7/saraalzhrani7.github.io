<script>
(function(){
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var currentLang = 'ar';

  var titleAr = document.title;
  var titleEn = 'Sara Alzahrani | Data & Security Analyst';
  var descAr = 'محللة بيانات وأمن معلومات — Power BI · SQL · مراقبة SOC. بورتفوليو يعرض مشاريع لوحات معلومات وتحليل بيانات أمنية.';
  var descEn = 'Data & Security Analyst — Power BI · SQL · SOC monitoring. A portfolio of dashboard and security data-analysis projects.';

  function setLang(lang){
    currentLang = lang;
    document.documentElement.lang = lang;
    document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
    document.querySelectorAll('[data-i18n="ar"]').forEach(function(el){ el.hidden = (lang !== 'ar'); });
    document.querySelectorAll('[data-i18n="en"]').forEach(function(el){ el.hidden = (lang !== 'en'); });
    document.title = lang === 'ar' ? titleAr : titleEn;
    var metaDesc = document.querySelector('meta[name="description"]');
    if(metaDesc){ metaDesc.setAttribute('content', lang === 'ar' ? descAr : descEn); }
    var toggle = document.getElementById('langToggle');
    if(toggle){ toggle.textContent = lang === 'ar' ? 'EN' : 'AR'; }
    var cmdInput = document.getElementById('cmdInput');
    if(cmdInput){ cmdInput.placeholder = lang === 'ar' ? 'وين تبين تروحين؟ (مشاريع، خبرات، تواصل...)' : 'Where to? (projects, experience, contact...)'; }
  }

  var langToggle = document.getElementById('langToggle');
  if(langToggle){
    langToggle.addEventListener('click', function(){
      setLang(currentLang === 'ar' ? 'en' : 'ar');
    });
  }

  /* ===== Hero decrypt reveal ===== */
  function revealHero(){
    var h1 = document.querySelector('.hero-main h1');
    if(!h1 || h1.dataset.revealed) return;
    h1.dataset.revealed = '1';
    if(reduceMotion) return;
    var pool = currentLang === 'ar' ? 'ابتثجحخدذرزسشصضطظعغفقكلمنهوي٠١٢٣٤٥٦٧٨٩' : 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    function scrambleNode(node, duration){
      var original = node.textContent;
      var len = original.length;
      if(!len) return;
      var start = null;
      function frame(ts){
        if(start === null) start = ts;
        var t = Math.min(1, (ts-start)/duration);
        var revealCount = Math.floor(t*len);
        var out = '';
        for(var i=0;i<len;i++){
          var ch = original[i];
          if(ch === ' ' || ch === '\n' || i < revealCount){ out += ch; }
          else{ out += pool[Math.floor(Math.random()*pool.length)]; }
        }
        node.textContent = out;
        if(t < 1){ requestAnimationFrame(frame); }
        else{ node.textContent = original; }
      }
      requestAnimationFrame(frame);
    }
    function walk(el){
      el.childNodes.forEach(function(n){
        if(n.nodeType === 3){ scrambleNode(n, 650); }
        else if(n.nodeType === 1){ walk(n); }
      });
    }
    walk(h1);
  }

  /* ===== Boot sequence ===== */
  var bootScreen = document.getElementById('bootScreen');
  var bootLines = document.getElementById('bootLines');
  function finishBoot(){
    if(!bootScreen){ revealHero(); return; }
    bootScreen.classList.add('hide');
    setTimeout(function(){
      if(bootScreen && bootScreen.parentNode){ bootScreen.parentNode.removeChild(bootScreen); }
    }, 400);
    revealHero();
  }
  if(bootScreen && bootLines && !reduceMotion){
    var lines = [
      'booting sara.alzahrani::profile',
      'loading modules » data-analysis, cyber-security',
      'mounting portfolio.sara ... OK',
      'access granted'
    ];
    var li = 0, ci = 0, full = '';
    function typeNext(){
      if(li >= lines.length){ setTimeout(finishBoot, 220); return; }
      var line = lines[li];
      if(ci <= line.length){
        bootLines.textContent = full + line.slice(0, ci);
        var caret = document.createElement('span');
        caret.className = 'boot-cursor';
        bootLines.appendChild(caret);
        ci++;
        setTimeout(typeNext, 5 + Math.random()*7);
      } else {
        full += line + '\n';
        li++; ci = 0;
        setTimeout(typeNext, 60);
      }
    }
    typeNext();
    bootScreen.addEventListener('click', finishBoot);
    document.addEventListener('keydown', function skipOnce(){
      finishBoot();
      document.removeEventListener('keydown', skipOnce);
    }, {once:true});
  } else {
    if(bootScreen && bootScreen.parentNode){ bootScreen.parentNode.removeChild(bootScreen); }
    revealHero();
  }

  /* ===== Session uptime ===== */
  var uptimeEl = document.getElementById('uptimeClock');
  if(uptimeEl){
    var startTime = Date.now();
    setInterval(function(){
      var s = Math.floor((Date.now()-startTime)/1000);
      var mm = String(Math.floor(s/60)).padStart(2,'0');
      var ss = String(s%60).padStart(2,'0');
      uptimeEl.textContent = mm + ':' + ss;
    }, 1000);
  }

  /* ===== Command palette ===== */
  var cmdTrigger = document.getElementById('cmdTrigger');
  var cmdOverlay = document.getElementById('cmdOverlay');
  var cmdInput = document.getElementById('cmdInput');
  var cmdList = document.getElementById('cmdList');
  var commands = [
    {label:'الرئيسية', labelEn:'Home', hint:'hero', action:function(){ scrollToSel('body'); } },
    {label:'التحليل السريع', labelEn:'Quick Analysis', hint:'scenario', action:function(){ scrollToSel('#scenario'); } },
    {label:'نبذة عني', labelEn:'About', hint:'about', action:function(){ scrollToSel('#about'); } },
    {label:'المشاريع', labelEn:'Projects', hint:'projects', action:function(){ scrollToSel('#projects'); } },
    {label:'الخبرات العملية', labelEn:'Experience', hint:'experience', action:function(){ scrollToSel('#experience'); } },
    {label:'الشهادات', labelEn:'Certifications', hint:'certifications', action:function(){ scrollToSel('#certifications'); } },
    {label:'تواصل معي', labelEn:'Contact', hint:'contact', action:function(){ scrollToSel('#contact'); } },
    {label:'تحميل السيرة الذاتية', labelEn:'Download CV', hint:'cv.pdf', action:function(){ window.open('Sara_Alzahrani_Data_Analyst_CV.pdf','_blank'); closeCmd(); } },
    {label:'GitHub', labelEn:'GitHub', hint:'github.com', action:function(){ window.open('https://github.com/saraalzhrani7','_blank'); closeCmd(); } },
    {label:'لينكدإن', labelEn:'LinkedIn', hint:'linkedin.com', action:function(){ window.open('https://www.linkedin.com/in/sara-alzahrani-10505727b','_blank'); closeCmd(); } }
  ];
  var activeIndex = 0;

  function scrollToSel(sel){
    closeCmd();
    if(sel === 'body'){ window.scrollTo({top:0, behavior: reduceMotion? 'auto':'smooth'}); return; }
    var target = document.querySelector(sel);
    if(target){ target.scrollIntoView({behavior: reduceMotion? 'auto':'smooth', block:'start'}); }
  }

  function currentFiltered(){
    var f = (cmdInput.value||'').trim().toLowerCase();
    return commands.filter(function(c){
      var lbl = (currentLang === 'ar' ? c.label : c.labelEn).toLowerCase();
      return lbl.indexOf(f) !== -1 || c.hint.toLowerCase().indexOf(f) !== -1;
    });
  }

  function renderCmdList(){
    var filtered = currentFiltered();
    cmdList.innerHTML = '';
    if(!filtered.length){
      var empty = document.createElement('li');
      empty.className = 'cmd-empty';
      empty.textContent = currentLang === 'ar' ? 'ما فيه نتائج' : 'No results';
      cmdList.appendChild(empty);
      return;
    }
    filtered.forEach(function(c, i){
      var li = document.createElement('li');
      li.className = 'cmd-item' + (i===activeIndex? ' active':'');
      var span = document.createElement('span');
      span.textContent = currentLang === 'ar' ? c.label : c.labelEn;
      var hint = document.createElement('span');
      hint.className = 'hint mono';
      hint.textContent = c.hint;
      li.appendChild(span);
      li.appendChild(hint);
      li.addEventListener('click', function(){ c.action(); });
      li.addEventListener('mousemove', function(){ if(activeIndex !== i){ activeIndex = i; renderCmdList(); } });
      cmdList.appendChild(li);
    });
  }

  function openCmd(){
    if(!cmdOverlay) return;
    cmdOverlay.hidden = false;
    activeIndex = 0;
    cmdInput.value = '';
    renderCmdList();
    setTimeout(function(){ cmdInput.focus(); }, 10);
  }
  function closeCmd(){
    if(!cmdOverlay) return;
    cmdOverlay.hidden = true;
  }

  if(cmdTrigger){ cmdTrigger.addEventListener('click', openCmd); }
  if(cmdOverlay){ cmdOverlay.addEventListener('click', function(e){ if(e.target === cmdOverlay){ closeCmd(); } }); }
  if(cmdInput){
    cmdInput.addEventListener('input', function(){ activeIndex = 0; renderCmdList(); });
    cmdInput.addEventListener('keydown', function(e){
      var filtered = currentFiltered();
      if(e.key === 'ArrowDown'){ e.preventDefault(); activeIndex = Math.min(filtered.length-1, activeIndex+1); renderCmdList(); }
      else if(e.key === 'ArrowUp'){ e.preventDefault(); activeIndex = Math.max(0, activeIndex-1); renderCmdList(); }
      else if(e.key === 'Enter'){ e.preventDefault(); if(filtered[activeIndex]){ filtered[activeIndex].action(); } }
      else if(e.key === 'Escape'){ closeCmd(); }
    });
  }
  document.addEventListener('keydown', function(e){
    var tag = (document.activeElement && document.activeElement.tagName) || '';
    var typing = tag === 'INPUT' || tag === 'TEXTAREA';
    if(!typing && e.key === '/'){ e.preventDefault(); openCmd(); }
    else if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'){ e.preventDefault(); openCmd(); }
    else if(e.key === 'Escape'){ closeCmd(); }
  });

  /* ===== Easter egg: type "sudo" ===== */
  var eggOverlay = document.getElementById('eggOverlay');
  var eggClose = document.getElementById('eggClose');
  var buffer = '';
  document.addEventListener('keydown', function(e){
    if(e.key.length !== 1) return;
    var tag = (document.activeElement && document.activeElement.tagName) || '';
    if(tag === 'INPUT' || tag === 'TEXTAREA') return;
    buffer = (buffer + e.key.toLowerCase()).slice(-4);
    if(buffer === 'sudo' && eggOverlay){ eggOverlay.hidden = false; }
  });
  if(eggClose){ eggClose.addEventListener('click', function(){ eggOverlay.hidden = true; }); }
  if(eggOverlay){ eggOverlay.addEventListener('click', function(e){ if(e.target === eggOverlay){ eggOverlay.hidden = true; } }); }
})();
</script>
